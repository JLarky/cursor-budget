    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.80.0",
    "@types/node": "^24.3.0",
    "oxlint": "^1.80.0",
    "typescript": "^5.9.2"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JLarky/llm-budget.git"
  },
  "bugs": {
    "url": "https://github.com/JLarky/llm-budget/issues"
  },
  "homepage": "https://github.com/JLarky/llm-budget#readme"
