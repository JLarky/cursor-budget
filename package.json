{
  "name": "llm-budget",
  "version": "0.1.0",
  "description": "Usage guards for Claude Code, Codex, and Cursor Agent — real reported usage, not estimates.",
  "license": "MIT",
  "keywords": [
    "llm",
    "budget",
    "quota",
    "usage",
    "hooks",
    "claude-code",
    "codex",
    "cursor-agent"
  ],
  "type": "module",
  "bin": {
    "llm-budget": "./dist/llm/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "lint": "oxlint && oxlint -c tools/oxlint/anti-slop/oxlint.config.ts tools/oxlint/anti-slop",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tools/oxlint/anti-slop/tsconfig.json",
    "test": "tsc && node --test 'dist/**/*.test.js' && npm run test:anti-slop",
    "test:anti-slop": "node tools/oxlint/anti-slop/run-tests.mjs"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.0.2",
      "onFail": "download"
    }
  },
  "dependencies": {
    "smol-toml": "^1.8.0",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.80.0",
    "@types/node": "^24.3.0",
    "oxlint": "^1.80.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JLarky/llm-budget.git"
  },
  "bugs": {
    "url": "https://github.com/JLarky/llm-budget/issues"
  },
  "homepage": "https://github.com/JLarky/llm-budget#readme"
}
