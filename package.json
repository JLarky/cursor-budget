{
  "name": "llm-budget",
  "version": "0.1.0",
  "description": "Usage guards for Claude Code, Codex, and Cursor Agent — real reported usage, not estimates.",
  "license": "MIT",
  "keywords": [
    "llm",
    "budget",
    "quota",
    "usage",
    "hooks",
    "claude-code",
    "codex",
    "cursor-agent"
  ],
  "type": "module",
  "bin": {
    "llm-budget": "./dist/llm/cli.js"
  },
  "scripts": {
